# Copy this file to .env.local and fill in real values. Never commit real credentials.
DATABASE_URL=

# Classifies the database DATABASE_URL points at: development | staging | production.
# Read only by the db:seed and db:reset tooling, never by the application.
# It describes the data, not the process, because a local process can be pointed
# at a shared database. There is no default: unset or unrecognized values are refused.
# Seeding requires development or staging; resetting requires development.
# Left blank deliberately — classify the database yourself rather than inheriting
# a value from this template.
DATABASE_ENV=

# Destructive unlock for db:reset. Must be exactly the string "true"; any other
# value (including "1", "TRUE", or unset) refuses. It can never unlock a
# production process or a database classified as production.
ALLOW_DB_RESET=
